#!/bin/sh
# Stand-in for Claude Code: answer the readiness probe, write the arguments and
# standard input of the latest call to claude.log, then print a fixed answer.
if [ "$1" = "--version" ]; then
    echo "0.0.0 (proof stub)"
    exit 0
fi
{
    for argument in "$@"; do
        echo "arg: $argument"
    done
    IFS= read -r line && echo "stdin: $line"
} > claude.log
echo "ollie"
