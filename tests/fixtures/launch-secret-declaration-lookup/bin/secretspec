#!/bin/sh
# Stub for secretspec. Each call appends a `call` line and then its
# arguments, one per line, to secretspec.log in the scene directory. Rune
# calls it as `get <key> --file <declaration> ...`. Like secretspec, it
# refuses a key that the declaration does not list, so a fixture whose
# config and declaration name different keys fails its scenes. With
# PROOF_SECRETSPEC_FAIL set, it fails the way secretspec does when a dotenv
# provider cannot parse its store: the report quotes another key's value.
log="$(dirname "$0")/../secretspec.log"
printf 'call\n' >> "$log"
printf '%s\n' "$@" >> "$log"
if ! grep -q "^$2 *=" "$4"; then
    printf 'Error: secret %s is not declared in %s\n' "$2" "$4" >&2
    exit 1
fi
if [ -n "$PROOF_SECRETSPEC_FAIL" ]; then
    printf 'warning: primary provider dotenv:.env failed\n1 | OTHER_KEY="FAKE-LEAK-VALUE\nError:   x Failed to get secret\n  dotenv syntax error at line 1\n' >&2
    exit 1
fi
printf 'from-secretspec'
