#!/usr/bin/env bash
set -euo pipefail

# jj runs no git hooks, so the pre-push checks live here instead.
# `make install` wires this as the repo-local jj `push` alias:
#   jj config set --repo aliases.push '["util","exec","--","bash","<repo>/.githooks/jj-push"]'
# Every local branch diverged from its origin counterpart is fed to pre-push
# as a synthesized ref-update line, the same protocol git uses, so bookmark
# pushes get range-scoped checks instead of a HEAD-only fallback. Branches
# tracking other remotes are outside this net. Then hands off to jj git push.

cd "$(jj workspace root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || dirname "$0")"

zero=0000000000000000000000000000000000000000

synthesize_ref_updates() {
    git for-each-ref refs/heads --format='%(refname) %(objectname)' \
        | while read -r ref sha; do
            remote_sha=$(git rev-parse -q --verify \
                "refs/remotes/origin/${ref#refs/heads/}" 2>/dev/null || printf '%s' "$zero")
            [ "$remote_sha" = "$sha" ] && continue
            printf '%s %s %s %s\n' "$ref" "$sha" "$ref" "$remote_sha"
        done
}

# The hook receives the same arguments git passes (remote name and url):
# pre-push runs its extension point only for a real push, and this is one.
synthesize_ref_updates | bash "$(git rev-parse --show-toplevel)/.githooks/pre-push" \
    origin "$(git remote get-url origin 2>/dev/null || printf 'origin')"

exec jj git push "$@"
