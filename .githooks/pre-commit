#!/usr/bin/env bash
set -euo pipefail

# Commit-time checks: prek hooks when configured, staged secret scan as the
# floor. A machine with neither tool fails loudly rather than committing
# unscanned, matching the pre-push hook's stance.

# Arguments pass through: make validate widens the run with --all-files,
# while a git-invoked hook arrives bare and checks the staged set. The
# ${1+"$@"} form expands to nothing when the hook arrives bare, which
# bash 4.0 through 4.3 need under set -u.
all_files=false
for argument in ${1+"$@"}; do
    [ "$argument" = "--all-files" ] && all_files=true
done

scan_file() {
    if [ -f .gitleaks.toml ]; then
        gitleaks dir --config .gitleaks.toml --no-banner "$1"
    else
        gitleaks dir --no-banner "$1"
    fi
}

scan_tracked_files() {
    local scan_failed=false
    local tracked_files

    tracked_files=$(mktemp)
    git ls-files -z > "$tracked_files" || {
        echo "  ⚠  git ls-files failed — the tracked-file scan cannot run" >&2
        rm -f "$tracked_files"
        return 1
    }

    while IFS= read -r -d '' file; do
        [ -f "$file" ] || continue
        scan_file "$file" || scan_failed=true
    done < "$tracked_files"
    rm -f "$tracked_files"

    [ "$scan_failed" = "false" ]
}

if command -v prek >/dev/null 2>&1 && [ -f .pre-commit-config.yaml ]; then
    # Both stages run and both report before the hook decides: a secret
    # in the sweep never hides a lint failure and a lint failure never
    # hides a secret. The sweep's guard stays reachable on a machine
    # without gitleaks because prek's failure no longer exits early.
    hook_failed=false
    prek run ${1+"$@"} || hook_failed=true
    if [ "$all_files" = "true" ]; then
        if command -v gitleaks >/dev/null 2>&1; then
            scan_tracked_files || hook_failed=true
        else
            echo "  ⚠  gitleaks not found — the tracked-file secret sweep was skipped" >&2
        fi
    fi
    [ "$hook_failed" = "false" ]
elif command -v gitleaks >/dev/null 2>&1; then
    if [ "$all_files" = "true" ]; then
        scan_tracked_files
    else
        gitleaks git --staged --pre-commit --no-banner
    fi
else
    echo "  ⚠  neither prek nor gitleaks found — commit checks cannot run" >&2
    echo "     install: brew install prek gitleaks" >&2
    exit 1
fi
