#!/usr/bin/env bash
set -euo pipefail

# rune module pre-commit hook
# Canonical source: https://github.com/runedeck/rune/blob/main/templates/git/pre-commit

if command -v prek >/dev/null 2>&1; then
    prek run --all-files
elif command -v rune >/dev/null 2>&1; then
    rune validate
else
    echo ""
    echo "  ⚠  Neither prek nor rune found — using validate.sh fallback"
    echo "     Install: cargo install --locked rune-cli   or   cargo binstall prek"
    echo ""
    bash scripts/validate.sh .
fi
