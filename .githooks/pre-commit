#!/usr/bin/env bash
set -euo pipefail

all_files=false
for argument in ${1+"$@"}; do
    [ "$argument" = "--all-files" ] && all_files=true
done

scan_snapshot() {
    local snapshot_directory=$1
    local config_path="$PWD/.gitleaks.toml"

    if [ -f "$config_path" ]; then
        (cd "$snapshot_directory" && gitleaks dir --config "$config_path" --no-banner .)
    else
        (cd "$snapshot_directory" && gitleaks dir --no-banner .)
    fi
}

list_tracked_files() {
    if [ -d .jj ] && command -v jj >/dev/null 2>&1; then
        jj file list --ignore-working-copy -r @ -T 'path ++ "\0"'
    else
        git ls-files -z
    fi
}

scan_tracked_files() {
    local scan_directory
    local scan_failed=false

    if ! command -v gitleaks >/dev/null 2>&1 || ! command -v rsync >/dev/null 2>&1; then
        echo "  ⚠  gitleaks and rsync are required for the tracked-file scan" >&2
        return 1
    fi

    scan_directory=$(mktemp -d)
    list_tracked_files \
        | rsync --archive --from0 --files-from=- ./ "$scan_directory/" || {
            echo "  ⚠  tracked files could not be copied for secret scanning" >&2
            rm -rf "$scan_directory"
            return 1
        }

    scan_snapshot "$scan_directory" || scan_failed=true
    rm -rf "$scan_directory"

    [ "$scan_failed" = "false" ]
}

if command -v prek >/dev/null 2>&1 && [ -f .pre-commit-config.yaml ]; then
    prek run ${1+"$@"}
    [ "$all_files" = "false" ] || scan_tracked_files
elif [ "$all_files" = "true" ]; then
    scan_tracked_files
elif command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged --pre-commit --no-banner
else
    echo "  ⚠  neither prek nor gitleaks found — commit checks cannot run" >&2
    echo "     install: brew install prek gitleaks" >&2
    exit 1
fi
