[1033.13,"o","\u001b[2;3m# the scene holds the lock of the Codex table's folder, so install one takes the Claude lock and waits\u001b[0m\r\n"]
[1034.33,"o","\u001b[2;3m# install two starts with another config, session-capture alone, and waits behind install one\u001b[0m\r\n"]
[1035.53,"o","\u001b[1;32m❯\u001b[0m "]
[1035.53,"o","sh"]
[1035.59,"o"," "]
[1035.59,"o","-s"]
[1035.65,"o","\r\n"]
[1035.65,"o","\u001b[2m< hold='import fcntl, os, sys, time\u001b[0m\r\n"]
[1035.71,"o","\u001b[2m< f = open(sys.argv[1], \"a\"); fcntl.flock(f, fcntl.LOCK_EX); open(\"held\", \"w\").close()\u001b[0m\r\n"]
[1035.77,"o","\u001b[2m< while not os.path.exists(\"release\"): time.sleep(0.02)'\u001b[0m\r\n"]
[1035.83,"o","\u001b[2m< taken='import fcntl, sys, time\u001b[0m\r\n"]
[1035.89,"o","\u001b[2m< for _ in range(500):\u001b[0m\r\n"]
[1035.95,"o","\u001b[2m<     f = open(sys.argv[1], \"a\")\u001b[0m\r\n"]
[1036.01,"o","\u001b[2m<     try: fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\u001b[0m\r\n"]
[1036.07,"o","\u001b[2m<     except BlockingIOError: sys.exit(0)\u001b[0m\r\n"]
[1036.13,"o","\u001b[2m<     fcntl.flock(f, fcntl.LOCK_UN); f.close(); time.sleep(0.02)\u001b[0m\r\n"]
[1036.19,"o","\u001b[2m< sys.exit(1)'\u001b[0m\r\n"]
[1036.25,"o","\u001b[2m< mkdir -p home/.codex\u001b[0m\r\n"]
[1036.31,"o","\u001b[2m< python3 -c \"$hold\" home/.codex/.rune-install.lock & holder=$!\u001b[0m\r\n"]
[1036.37,"o","\u001b[2m< while [ ! -e held ]; do sleep 0.02; done\u001b[0m\r\n"]
[1036.43,"o","\u001b[2m< HOME=\"$PWD/home\" RUNE_STATE_DIR=state rune hook install > one.out 2>&1 & one=$!\u001b[0m\r\n"]
[1036.49,"o","\u001b[2m< python3 -c \"$taken\" home/.claude/.rune-install.lock && echo \"install one holds the Claude lock\"\u001b[0m\r\n"]
[1036.55,"o","\u001b[2m< cp -f \"$RUNE_PROOF_ROOT/tests/fixtures/hooks/session-only/.config/rune/config.yaml\" home/.config/rune/config.yaml\u001b[0m\r\n"]
[1036.61,"o","\u001b[2m< HOME=\"$PWD/home\" RUNE_STATE_DIR=state rune hook install > two.out 2>&1 & two=$!\u001b[0m\r\n"]
[1036.67,"o","\u001b[2m< sleep 1\u001b[0m\r\n"]
[1036.73,"o","\u001b[2m< kill -0 $one && kill -0 $two && echo \"both installs still run\"\u001b[0m\r\n"]
[1036.79,"o","\u001b[2m< cmp claude.before home/.claude/settings.json && test ! -e home/.codex/hooks.json && test ! -e state/hooks/manifest.json && echo \"no table and no manifest changed while they wait\"\u001b[0m\r\n"]
[1036.85,"o","\u001b[2m< touch release\u001b[0m\r\n"]
[1036.91,"o","\u001b[2m< wait $holder\u001b[0m\r\n"]
[1036.97,"o","\u001b[2m< wait $one; echo \"install one exited $?\"\u001b[0m\r\n"]
[1037.03,"o","\u001b[2m< wait $two; echo \"install two exited $?\"\u001b[0m\r\n"]
[1037.24,"o","install one holds the Claude lock\r\nboth installs still run\r\nno table and no manifest changed while they wait\r\ninstall one exited 0\r\ninstall two exited 0\r\n"]
[1037.64,"o","\u001b[32m✓\u001b[0m \u001b[2mexit 0 · output matches\u001b[0m\r\n"]
