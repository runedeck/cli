[1099.57,"o","\u001b[2m< HOME=\"$PWD/home\" XDG_CONFIG_HOME=\"$PWD/home/.config\" RUNE_STATE_DIR=state rune hook install > two.out 2>&1 & two=$!\u001b[0m\r\n"]
[1099.63,"o","\u001b[2m< sleep 1\u001b[0m\r\n"]
