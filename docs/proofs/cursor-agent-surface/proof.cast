[36.855, "o", "{\"details\":{\"message\":\"a read-only cursor run refuses approvalMode unrestricted: ask mode is enforced by cursor-agent, and unrestricted is the one approval mode that would run a write without asking if that enforcement failed; set approvalMode to allowlist or auto-review in cli-config.json, or run with --mode workspace-write\"},\"kind\":\"configuration_error\",\"ok\":false,\"tool\":\"cursor\"}\r\nexit 2\r\n"]
